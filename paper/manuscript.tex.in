\title{ModalStripe: Modal Memory and Attention\\in Small Language Models}
\author{Atay Kim\\[3pt]\normalsize Nazarbayev University\\\normalsize Astana, Kazakhstan\\\normalsize\href{mailto:atay.kim@nu.edu.kz}{\texttt{atay.kim@nu.edu.kz}}}
